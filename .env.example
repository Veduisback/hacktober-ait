# ── Optional: override config.yaml values via environment variables ───────────
# Copy to .env and fill in values (none are required for the default stack).

# Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# HuggingFace token (OPTIONAL — only for gated HF Hub models like Gemma/Llama)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override SQLite path (OPTIONAL)
# DB_PATH=data/hospital.db
